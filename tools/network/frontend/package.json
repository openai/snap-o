{
  "name": "@snap-o/network-tool",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier . ../../frontend --config .prettierrc.json --write",
    "format:check": "prettier . ../../frontend --config .prettierrc.json --check",
    "lint": "eslint . && stylelint \"src/**/*.css\" \"../../frontend/*.css\" --config stylelint.config.mjs",
    "build:host": "tsc -p ../../../tool-sdk/host/tsconfig.build.json",
    "postinstall": "npm run build:host",
    "prebuild": "npm run build:host",
    "predev": "npm run build:host"
  },
  "dependencies": {
    "@snap-o/tool-host": "file:../../../tool-sdk/host",
    "preact": "^10.29.8",
    "lucide-preact": "^0.577.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "preact-render-to-string": "^6.7.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.9",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "devtools-protocol": "^0.0.1704034"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
