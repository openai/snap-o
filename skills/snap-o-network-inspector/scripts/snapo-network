#!/usr/bin/env python3
"""Inspect Snap-O Network through the configured adb command."""

import argparse
import asyncio
import base64
import gzip
import hashlib
import http.client
import inspect
import json
import math
import os
import pathlib
import re
import runpy
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
import types
import uuid
from collections import deque
from collections.abc import MutableMapping
from contextlib import closing
from dataclasses import dataclass, field
from urllib.parse import quote


SOCKET_PREFIX = "snapo_network_"
NETWORK_PROTOCOL_VERSION = 4
MAX_RECORD_BYTES = 16 * 1024 * 1024
MAX_BODY_BYTES = 1024 * 1024
_UNSET = object()
REDACTED = "[REDACTED]"
REQUEST_HEADERS = {"authorization", "cookie"}
RESPONSE_HEADERS = {"set-cookie"}

ADB_COMMAND_TIMEOUT = 30
MAX_HTTP_RESPONSE_BYTES = 16 * 1024 * 1024


class SnapOError(Exception):
    pass


@dataclass(frozen=True)
class Server:
    device_id: str
    socket_name: str

    @property
    def identifier(self):
        return f"{self.device_id}/{self.socket_name}"

    @property
    def pid(self):
        suffix = self.socket_name.rsplit("_", 1)[-1]
        return int(suffix) if suffix.isdigit() else None


def resolve_adb(explicit=None, environ=None, which=shutil.which):
    environ = os.environ if environ is None else environ
    configured = explicit or environ.get("SNAPO_ADB")
    if configured:
        resolved = which(configured) if os.sep not in configured else configured
        if resolved and os.path.isfile(resolved) and os.access(resolved, os.X_OK):
            return resolved
        raise SnapOError(f"adb executable was not found at '{configured}'")

    resolved = which("adb")
    if resolved:
        return resolved

    for key in ("ANDROID_SDK_ROOT", "ANDROID_HOME"):
        sdk_root = environ.get(key)
        if not sdk_root:
            continue
        candidate = os.path.join(sdk_root, "platform-tools", "adb")
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    raise SnapOError(
        "adb was not found; add platform-tools to PATH, set ANDROID_SDK_ROOT, or pass --adb"
    )


class ADB:
    def __init__(self, executable, host=None, port=None, run=subprocess.run, timeout=ADB_COMMAND_TIMEOUT):
        self.executable = executable
        self.host = host
        self.port = port
        self._run = run
        self.timeout = timeout

    @property
    def has_explicit_endpoint(self):
        return self.host is not None or self.port is not None

    @property
    def endpoint(self):
        return self.host or "127.0.0.1", self.port or 5037

    def command(self, *arguments, serial=None):
        command = [self.executable]
        if self.host:
            command += ["-H", self.host]
        if self.port:
            command += ["-P", str(self.port)]
        if serial:
            command += ["-s", serial]
        command += list(arguments)
        try:
            result = self._run(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                check=False,
                timeout=self.timeout,
            )
        except subprocess.TimeoutExpired as error:
            raise SnapOError(f"adb command timed out after {self.timeout} seconds") from error
        except OSError as error:
            raise SnapOError(f"failed to run adb: {error}") from error
        if result.returncode:
            detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
            raise SnapOError(f"adb command failed: {detail}")
        return result.stdout

    def devices(self):
        return parse_devices(self.command("devices", "-l"))

    def sockets(self, serial, prefix):
        output = self.command("shell", "cat /proc/net/unix", serial=serial)
        return parse_sockets(output, prefix)

    def process_info(self, server):
        output = self.command("shell", f"cat /proc/{server.pid}/status /proc/{server.pid}/stat /proc/{server.pid}/cmdline", serial=server.device_id)
        return parse_process_info(output, server.pid)

    def packages_for_uid(self, serial, uid):
        output = self.command("shell", f"cmd package list packages -U --user {uid // 100000}", serial=serial)
        packages = []
        for line in output.splitlines():
            match = re.fullmatch(r"package:([A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)+) uid:([0-9]+)", line.strip())
            if match and int(match[2]) == uid:
                packages.append(match[1])
        return sorted(set(packages))


def parse_devices(output):
    devices = []
    for line in output.splitlines():
        fields = line.split()
        if len(fields) >= 2 and fields[1].lower() in {"device", "emulator"}:
            devices.append(fields[0])
    return devices


def parse_sockets(output, prefix=SOCKET_PREFIX):
    sockets = set()
    for line in output.splitlines():
        fields = line.split()
        if len(fields) < 8 or fields[3:6] != ["00010000", "0001", "01"]:
            continue
        name = fields[-1]
        if re.fullmatch(re.escape("@" + prefix) + r"[1-9][0-9]{0,9}", name):
            sockets.add(name[1:])
    return sorted(sockets)


def select_devices(devices, serial=None, usb=False, emulator=False):
    if serial:
        if serial not in devices:
            raise SnapOError(f"Device '{serial}' is not connected")
        return [serial]
    if emulator:
        matches = [device for device in devices if device.startswith("emulator-")]
        if not matches:
            raise SnapOError("No emulator connected")
        if len(matches) > 1:
            raise SnapOError("More than one emulator connected; use -s <serial>")
        return matches
    if usb:
        matches = [device for device in devices if not device.startswith("emulator-")]
        if not matches:
            raise SnapOError("No USB device connected")
        if len(matches) > 1:
            raise SnapOError("More than one USB device connected; use -s <serial>")
        return matches
    return devices


def discover(adb, options, prefix=SOCKET_PREFIX):
    devices = select_devices(
        adb.devices(),
        serial=options.serial,
        usb=options.usb,
        emulator=options.emulator,
    )
    if not devices:
        raise SnapOError("No connected devices found")
    servers = []
    for device in devices:
        try:
            servers.extend(Server(device, name) for name in adb.sockets(device, prefix))
        except SnapOError:
            continue
    return sorted(servers, key=lambda server: (server.device_id, server.socket_name))


def choose_server(servers, requested):
    if not servers:
        raise SnapOError("No Snap-O network servers found for selected device(s)")
    if not requested:
        if len(servers) == 1:
            return servers[0]
        choices = ", ".join(server.identifier for server in servers)
        raise SnapOError(f"Multiple sockets found; select one with -n/--socket. Available: {choices}")

    if "/" in requested:
        device_id, socket_name = requested.split("/", 1)
        matches = [
            server
            for server in servers
            if server.device_id == device_id and server.socket_name == socket_name
        ]
    else:
        matches = [server for server in servers if server.socket_name == requested]
    if not matches:
        raise SnapOError(f"No Snap-O network server named '{requested}' found")
    if len(matches) > 1:
        choices = ", ".join(server.identifier for server in matches)
        raise SnapOError(f"Socket '{requested}' exists on multiple devices. Available: {choices}")
    return matches[0]


class Forward:
    def __init__(self, adb, server):
        self.adb = adb
        self.server = server
        self.port = None

    def __enter__(self):
        output = self.adb.command(
            "forward",
            "tcp:0",
            f"localabstract:{self.server.socket_name}",
            serial=self.server.device_id,
        )
        try:
            self.port = int(output.strip())
        except (TypeError, ValueError) as error:
            raise SnapOError("ADB did not report the allocated forwarding port") from error
        return self

    def __exit__(self, error_type, error, traceback):
        if self.port is None:
            return False
        try:
            self.adb.command(
                "forward",
                "--remove",
                f"tcp:{self.port}",
                serial=self.server.device_id,
            )
        except SnapOError:
            if error_type is None:
                raise
        return False


class LocalAbstractSocket:
    def __init__(self, port=None, adb=None, server=None, timeout=5):
        endpoint = ("127.0.0.1", port) if adb is None else adb.endpoint
        try:
            self.socket = socket.create_connection(endpoint, timeout=timeout)
        except OSError as error:
            raise SnapOError(f"Failed to connect to Snap-O socket: {error}") from error
        try:
            if adb is not None:
                self.adb_request(f"host:transport:{server.device_id}")
                self.adb_request(f"localabstract:{server.socket_name}")
        except BaseException:
            self.socket.close()
            raise

    def adb_request(self, request):
        payload = request.encode("utf-8")
        if len(payload) > 0xFFFF:
            raise SnapOError("ADB request is too large")
        try:
            self.socket.sendall(f"{len(payload):04X}".encode("ascii") + payload)
        except OSError as error:
            raise SnapOError(f"Failed to write to ADB server: {error}") from error
        status = self.read_exact(4)
        if status == b"OKAY":
            return
        if status == b"FAIL":
            try:
                length = int(self.read_exact(4), 16)
            except ValueError as error:
                raise SnapOError("ADB returned an invalid failure response") from error
            message = self.read_exact(length).decode("utf-8", errors="replace")
            raise SnapOError(f"ADB rejected the connection: {message}")
        raise SnapOError("ADB returned an invalid status response")

    def read_exact(self, count):
        data = bytearray()
        while len(data) < count:
            try:
                chunk = self.socket.recv(count - len(data))
            except OSError as error:
                raise SnapOError(f"Failed to read from ADB server: {error}") from error
            if not chunk:
                raise SnapOError("ADB server closed the connection unexpectedly")
            data.extend(chunk)
        return bytes(data)


class ServerConnection:
    def __init__(self, adb, server):
        self.adb = adb
        self.server = server
        self.forward = None

    def __enter__(self):
        if not self.adb.has_explicit_endpoint:
            self.forward = Forward(self.adb, self.server)
            self.forward.__enter__()
        return self

    def __exit__(self, error_type, error, traceback):
        if self.forward is not None:
            return self.forward.__exit__(error_type, error, traceback)
        return False

    def open_socket(self, timeout=5):
        return LocalAbstractSocket(
            port=self.forward.port if self.forward is not None else None,
            adb=None if self.forward is not None else self.adb,
            server=self.server,
            timeout=timeout,
        )


class HTTPError(SnapOError):
    def __init__(self, status, message):
        self.status = status
        super().__init__(message)


class HTTPResponse:
    def __init__(self, open_socket, path, method="GET", body=None, accept="application/json"):
        self.transport = open_socket(10)
        self.http = http.client.HTTPConnection("localhost", timeout=10)
        self.http.sock = self.transport.socket
        self.response = None
        self.pending = bytearray()
        self.response_lock = threading.Lock()
        self.closed = False
        try:
            payload = b"" if body is None else json.dumps(body, separators=(",", ":"), allow_nan=False).encode("utf-8")
            if len(payload) > 2 * 1024 * 1024:
                raise SnapOError("Tool HTTP request is too large")
            self.http.request(method, path, body=payload, headers={
                "Accept": accept,
                "Content-Type": "application/json",
                "Connection": "close",
            })
            # Keep socket ownership here so a blocking stream can be interrupted.
            self.response = http.client.HTTPResponse(self.transport.socket)
            self.response.begin()
            if self.response.status not in (200, 201):
                message = f"Tool HTTP request failed ({self.response.status}); update Snap-O and the Android library"
                try:
                    error = json.loads(self.response.read(65536)).get("error")
                    if isinstance(error, str):
                        message = error
                except (ValueError, AttributeError):
                    pass
                raise HTTPError(self.response.status, message)
        except (OSError, http.client.HTTPException) as error:
            self.close()
            raise SnapOError(f"Tool HTTP request failed; check the Android library version: {error}") from error
        except BaseException:
            self.close()
            raise

    def read_json(self, limit=MAX_HTTP_RESPONSE_BYTES):
        try:
            if self.response.getheader("Content-Type", "").split(";")[0].strip() != "application/json":
                raise SnapOError("Expected a tool JSON response")
            with self.response_lock:
                data = self.response.read(limit + 1)
            if len(data) > limit:
                raise SnapOError("Tool HTTP response is too large")
            value = json.loads(data)
            if not isinstance(value, dict):
                raise SnapOError("Invalid tool HTTP response")
            return value
        except (OSError, http.client.HTTPException, ValueError) as error:
            raise SnapOError(f"Unable to read tool HTTP response: {error}") from error

    def read_line(self, limit=MAX_HTTP_RESPONSE_BYTES + 1):
        scanned = 0
        while True:
            end = self.pending.find(b"\n", scanned)
            if end >= 0:
                if end >= limit:
                    raise SnapOError("Tool HTTP line is too large")
                line = bytes(self.pending[:end + 1])
                del self.pending[:end + 1]
                return line
            if len(self.pending) >= limit:
                raise SnapOError("Tool HTTP line is too large")
            scanned = len(self.pending)
            # HTTPResponse.readline() can hide an incomplete chunked response.
            with self.response_lock:
                data = self.response.read1(64 * 1024)
            if not data:
                line = bytes(self.pending)
                self.pending.clear()
                return line
            self.pending.extend(data)

    def close(self):
        if self.closed:
            return
        self.closed = True
        # Release a blocking SSE read before closing its buffered HTTP reader.
        try:
            self.transport.socket.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        with self.response_lock:
            if self.response is not None:
                self.response.close()
        self.http.close()


def parse_process_info(output, pid):
    if len(output) > 65536:
        raise SnapOError("Process metadata is too large")
    uid = re.search(r"^Uid:\s+([0-9]+)(?:\s|$)", output, re.MULTILINE)
    stat = re.search(rf"^{pid} \(.*\) ([^\n]+)\n", output, re.MULTILINE)
    if uid is None or stat is None:
        raise SnapOError("Process metadata is unavailable")
    fields = stat[1].split()
    if len(fields) < 20 or not fields[19].isdigit():
        raise SnapOError("Invalid process start time")
    name = output[stat.end():].split("\0", 1)[0].strip()
    if not name or any(ord(character) < 32 for character in name):
        raise SnapOError("Invalid process name")
    return {"uid": int(uid[1]), "processName": name, "startTime": fields[19]}


def read_app_info(adb, servers):
    results = {}
    packages_by_uid = {}
    for server in servers:
        try:
            process = adb.process_info(server)
            key = server.device_id, process["uid"]
            if key not in packages_by_uid:
                packages_by_uid[key] = adb.packages_for_uid(*key)
            packages = packages_by_uid[key]
            hint = process["processName"].split(":", 1)[0]
            package = hint if hint in packages else packages[0] if len(packages) == 1 else None
            # Do not attribute metadata to a replacement process that reused the PID.
            if adb.process_info(server) != process:
                raise SnapOError("Process changed during discovery")
            results[server] = {"packageName": package, "processName": process["processName"]}
        except (SnapOError, OSError) as error:
            print(f"Cannot identify {server.identifier}: {error}", file=sys.stderr)
            results[server] = {}
    return results


def add_common_options(parser, socket_option=False, json_option=True):
    selection = parser.add_mutually_exclusive_group()
    selection.add_argument("-s", "--serial")
    selection.add_argument("-d", dest="usb", action="store_true")
    selection.add_argument("-e", dest="emulator", action="store_true")
    if socket_option:
        parser.add_argument("-n", "--socket")
    parser.add_argument("--adb", help="path to the configured adb executable or shim")
    parser.add_argument("--adb-host", help="explicit ADB server host (requires --adb-port)")
    parser.add_argument("--adb-port", type=valid_port, help="explicit ADB server port (requires --adb-host)")
    parser.add_argument("--adb-timeout", type=float, default=ADB_COMMAND_TIMEOUT, help="ADB command deadline in seconds, up to 90 (default: 30)")
    if json_option:
        parser.add_argument("--json", action="store_true", help="emit newline-delimited JSON")


def valid_port(value):
    try:
        port = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("port must be an integer") from error
    if not 1 <= port <= 65535:
        raise argparse.ArgumentTypeError("port must be between 1 and 65535")
    return port


def interrupted(signum, frame):
    # The parent CLI can send SIGTERM after the terminal has already sent SIGINT.
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    raise KeyboardInterrupt


class Session:
    def __init__(self, open_socket):
        self.open_socket = open_socket
        self.history = None
        self.events = None
        self.replaying = False
        self.watermark = None
        self.reader_thread = None
        self.closed = False
        self.records = deque()
        self.condition = threading.Condition()
        self.reader_error = None
        self.buffered_bytes = 0

    def close(self):
        self.closed = True
        if self.events is not None:
            self.events.close()
        if self.history is not None:
            self.history.close()
        with self.condition:
            self.condition.notify_all()
        if self.reader_thread is not None:
            self.reader_thread.join(timeout=2)

    def start_stream(self):
        if self.events is not None:
            return
        self.events = NetworkSSE(self.open_socket, "/network")
        self.reader_thread = threading.Thread(target=self._read_loop, daemon=True)
        self.reader_thread.start()
        self.history = NetworkHistory(self.open_socket)
        self.watermark = self.history.watermark
        self.replaying = True

    def _read_loop(self):
        try:
            while not self.closed:
                event = self.events.read_event()
                message = event["data"]
                sequence = message.get("snapoSequence") if isinstance(message, dict) else None
                if (not valid_record(message) or not str(message.get("method", "")).startswith("Network.")
                        or type(sequence) is not int or sequence < 0):
                    raise SnapOError("Invalid network event")
                if event["id"] and event["id"] != str(sequence):
                    raise SnapOError("Network SSE sequence does not match its event")
                size = event["size"]
                with self.condition:
                    if len(self.records) >= 4096 or self.buffered_bytes + size > 32 * 1024 * 1024:
                        raise SnapOError("Live event buffer filled; reconnect for a fresh snapshot")
                    self.records.append((message, size))
                    self.buffered_bytes += size
                    self.condition.notify_all()
        except SnapOError as error:
            with self.condition:
                self.reader_error = error
                self.condition.notify_all()
            self.events.close()

    def read(self, timeout):
        if self.reader_error is not None:
            raise self.reader_error
        if self.history is not None:
            message = self.history.read()
            if message is not None:
                return message
            self.history.close()
            self.history = None
            self.replaying = False
            return None
        deadline = time.monotonic() + timeout
        with self.condition:
            while True:
                if self.reader_error is not None:
                    raise self.reader_error
                while self.records:
                    message, size = self.records.popleft()
                    self.buffered_bytes -= size
                    if self.watermark is not None and message["snapoSequence"] <= self.watermark:
                        continue
                    return message
                if self.closed:
                    raise SnapOError("Snap-O session is closed")
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return None
                self.condition.wait(remaining)

    def body(self, request_id, response=False):
        kind = "response-body" if response else "request-body"
        path = f"/network/requests/{quote(request_id, safe='')}/{kind}"
        with closing(HTTPResponse(self.open_socket, path)) as response:
            return response.read_json()


def check_protocol(open_socket):
    try:
        with closing(HTTPResponse(open_socket, "/network/protocol")) as response:
            version = response.read_json(limit=4096).get("version")
    except SnapOError as error:
        raise SnapOError(f"Cannot check Network Tool protocol: {error}") from error
    if type(version) is not int or version != NETWORK_PROTOCOL_VERSION:
        reported = f"protocol v{version}" if type(version) is int else "no valid protocol version"
        raise SnapOError(
            f"Unsupported Network Tool protocol: app reports {reported}; this CLI supports v{NETWORK_PROTOCOL_VERSION}. "
            "Update Snap-O and the Android library together."
        )


class NetworkHistory(HTTPResponse):
    def __init__(self, open_socket):
        super().__init__(open_socket, "/network", accept="application/x-ndjson")
        try:
            if self.response.getheader("Content-Type", "").split(";")[0].strip() != "application/x-ndjson":
                raise SnapOError("Expected a network history response")
            cursor = self.response.getheader("SnapO-Sequence", "")
            if not cursor.isascii() or not cursor.isdecimal():
                raise SnapOError("Invalid history snapshot headers")
            self.watermark = int(cursor)
        except BaseException:
            self.close()
            raise

    def read(self):
        try:
            line = self.read_line()
            if not line:
                return None
            if len(line) > MAX_RECORD_BYTES + 1 or not line.endswith(b"\n"):
                raise SnapOError("Incomplete or oversized history record")
            message = json.loads(line)
            sequence = message.get("snapoSequence") if isinstance(message, dict) else None
            if not valid_record(message) or type(sequence) is not int or not 0 <= sequence <= self.watermark:
                raise SnapOError("Invalid history record")
            return message
        except (OSError, http.client.HTTPException, ValueError) as error:
            raise SnapOError(f"Unable to read network history: {error}") from error


class NetworkSSE(HTTPResponse):
    def __init__(self, open_socket, path, method="GET", body=None):
        super().__init__(open_socket, path, method, body, accept="text/event-stream")
        if self.response.getheader("Content-Type", "").split(";")[0].strip() != "text/event-stream":
            self.close()
            raise SnapOError("Expected a network SSE response")
        # Allow headroom beyond the server's 30-second heartbeat.
        self.transport.socket.settimeout(60)

    def read_event(self):
        data = bytearray()
        event_name = "message"
        event_id = ""
        try:
            while True:
                line = self.read_line(MAX_RECORD_BYTES + 128)
                if not line or not line.endswith(b"\n"):
                    raise SnapOError("Network event stream ended")
                line = line[:-1].removesuffix(b"\r")
                if not line:
                    if data:
                        return {"event": event_name, "id": event_id, "data": json.loads(data[:-1]), "size": len(data)}
                    event_name, event_id = "message", ""
                    continue
                field, _, value = line.partition(b":")
                value = value.removeprefix(b" ")
                if field == b"data":
                    if len(data) + len(value) > MAX_RECORD_BYTES:
                        raise SnapOError("Network SSE event is too large")
                    data.extend(value + b"\n")
                elif field == b"event":
                    event_name = value.decode("utf-8")
                elif field == b"id":
                    event_id = value.decode("utf-8")
        except (OSError, http.client.HTTPException, ValueError) as error:
            raise SnapOError(f"Unable to read network events: {error}") from error


def valid_record(message):
    if not isinstance(message, dict):
        return False

    method = message.get("method")
    if method is not None and not isinstance(method, str):
        return False

    params = message.get("params")
    if params is not None and not isinstance(params, dict):
        return False

    if params:
        if not valid_headers(params.get("headers")):
            return False
        for field in ("request", "response"):
            value = params.get(field)
            if value is not None and (
                not isinstance(value, dict) or not valid_headers(value.get("headers"))
            ):
                return False
        if not valid_request(params.get("request")) or not valid_response(params.get("response")):
            return False

    return all(
        message.get(field) is None or isinstance(message[field], dict)
        for field in ("result", "error")
    )


def valid_headers(headers):
    return headers is None or isinstance(headers, dict)


def valid_request(request):
    if request is None:
        return True
    if not all(
        request.get(field) is None or isinstance(request[field], str)
        for field in ("method", "url", "postDataEncoding")
    ):
        return False
    return request.get("hasPostData") is None or isinstance(request["hasPostData"], bool)


def valid_response(response):
    if response is None:
        return True
    url = response.get("url")
    if url is not None and not isinstance(url, str):
        return False
    status = response.get("status")
    return status is None or (
        isinstance(status, (int, float))
        and not isinstance(status, bool)
        and (not isinstance(status, float) or math.isfinite(status))
    )


class ConnectedSession:
    def __init__(self, adb, server):
        self.connection = ServerConnection(adb, server)
        self.session = None

    def __enter__(self):
        self.connection.__enter__()
        try:
            check_protocol(self.connection.open_socket)
            self.session = Session(self.connection.open_socket)
        except BaseException:
            self.connection.__exit__(*sys.exc_info())
            raise
        return self.session

    def __exit__(self, error_type, error, traceback):
        try:
            if self.session:
                self.session.close()
        finally:
            self.connection.__exit__(error_type, error, traceback)
        return False


def redact_headers(headers, sensitive):
    return {
        str(name): REDACTED if str(name).lower() in sensitive else stringify(value)
        for name, value in (headers or {}).items()
    }


def stringify(value):
    if isinstance(value, str):
        return value
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (dict, list)):
        return json.dumps(value, separators=(",", ":"), ensure_ascii=False)
    return str(value)


def sanitize_event(message):
    sanitized = dict(message)
    params = dict(message.get("params") or {})
    method = message.get("method")
    if method == "Network.requestWillBeSent":
        request = dict(params.get("request") or {})
        request["headers"] = redact_headers(request.get("headers"), REQUEST_HEADERS)
        params["request"] = request
    elif method == "Network.responseReceived":
        response = dict(params.get("response") or {})
        response["headers"] = redact_headers(response.get("headers"), RESPONSE_HEADERS)
        params["response"] = response
    elif method == "Network.webSocketCreated":
        params["headers"] = redact_headers(params.get("headers"), REQUEST_HEADERS)
    elif method == "Network.webSocketHandshakeResponseReceived":
        response = dict(params.get("response") or {})
        response["headers"] = redact_headers(response.get("headers"), RESPONSE_HEADERS)
        params["response"] = response
    else:
        return sanitized
    sanitized["params"] = params
    return sanitized


class EventFilter:
    def __init__(self, text):
        self.includes = []
        self.excludes = []
        self.request_ids = set()
        index = 0
        while index < len(text):
            while index < len(text) and text[index].isspace():
                index += 1
            if index == len(text):
                break

            excluded = text[index] == "-"
            if excluded:
                index += 1
            if index == len(text):
                break

            quoted = text[index] == '"'
            if quoted:
                index += 1

            characters = []
            while index < len(text):
                current = text[index]
                if quoted and current == '"':
                    index += 1
                    break
                if not quoted and current.isspace():
                    break

                if current == "\\" and index + 1 < len(text):
                    following = text[index + 1]
                    if following in {'"', "\\"} or (not quoted and following.isspace()):
                        characters.append(following)
                        index += 2
                        continue

                characters.append(current)
                index += 1

            value = "".join(characters)
            if value.strip():
                (self.excludes if excluded else self.includes).append(value.lower())

    def matches(self, message):
        if not self.includes and not self.excludes:
            return True
        params = message.get("params") or {}
        method = message.get("method")
        if method == "Network.requestWillBeSent":
            url = (params.get("request") or {}).get("url")
        elif method == "Network.responseReceived":
            url = (params.get("response") or {}).get("url")
        elif method == "Network.webSocketCreated":
            url = params.get("url")
        else:
            url = None
        request_id = params.get("requestId")
        if isinstance(url, str):
            normalized = url.lower()
            if all(value in normalized for value in self.includes) and not any(
                value in normalized for value in self.excludes
            ):
                if request_id is not None:
                    self.request_ids.add(str(request_id))
                return True
        return request_id is not None and str(request_id) in self.request_ids


def print_json(value):
    print(json.dumps(value, separators=(",", ":"), ensure_ascii=False), flush=True)


def event_line(message):
    method = message.get("method")
    params = message.get("params") or {}
    request_id = params.get("requestId", "?")
    if method == "Network.requestWillBeSent":
        request = params.get("request") or {}
        return f"REQUEST {request_id} {request.get('method', '?')} {request.get('url', '?')}"
    if method == "Network.responseReceived":
        response = params.get("response") or {}
        return f"RESPONSE {request_id} {display_number(response.get('status'), '?')} {response.get('url', 'unknown-url')}"
    if method == "Network.loadingFinished":
        return f"FINISH {request_id} bytes={display_number(params.get('encodedDataLength'), '0')}"
    if method == "Network.loadingFailed":
        return f"FAIL {request_id} {params.get('errorText', params.get('type', 'unknown-error'))}"
    if method in {"Network.webSocketFrameSent", "Network.webSocketFrameReceived"}:
        response = params.get("response") or {}
        direction = "WS-SENT" if method.endswith("Sent") else "WS-RECV"
        opcode = display_number(response.get("opcode"), "?")
        size = display_number(response.get("payloadSize"), "0")
        return f"{direction} {request_id} opcode={opcode} size={size}"
    return f"EVENT {method or json.dumps(message, separators=(',', ':'))}"


def display_number(value, fallback):
    if not isinstance(value, (int, float)):
        return fallback
    if isinstance(value, float) and value.is_integer():
        return str(int(value))
    return str(value)


def emit_event(message, as_json):
    message = sanitize_event(message)
    if as_json:
        print_json(message)
    else:
        print(event_line(message), flush=True)


def emit_app(server, name, package, as_json, current_device, details=""):
    if as_json:
        app = {
            "server": server.identifier,
            "deviceId": server.device_id,
            "socketName": server.socket_name,
            "packageName": package,
            "processName": name,
            "pid": server.pid,
        }
        print_json(app)
    else:
        if current_device != server.device_id:
            print(f"{server.device_id}:")
        print(f"    {server.socket_name}{details}")
    return server.device_id


def run_list(adb, options):
    servers = discover(adb, options)
    if not servers:
        raise SnapOError("No Snap-O network servers found")
    current_device = None
    apps = read_app_info(adb, servers) if options.include_app_info else {}
    for server in servers:
        info = {}
        if options.include_app_info:
            info = apps[server]
        package = info.get("packageName")
        process_name = info.get("processName")
        details = f"  pkg:{package or 'unknown'}" if options.include_app_info else ""
        current_device = emit_app(server, process_name, package, options.json, current_device, details)
    return 0


def run_requests(adb, options):
    server = choose_server(discover(adb, options), options.socket)
    event_filter = EventFilter(options.filter)
    if options.no_stream:
        with ServerConnection(adb, server) as connection:
            check_protocol(connection.open_socket)
            history = NetworkHistory(connection.open_socket)
            try:
                while (message := history.read()) is not None:
                    if event_filter.matches(message):
                        emit_event(message, options.json)
            finally:
                history.close()
        return 0
    with ConnectedSession(adb, server) as session:
        session.start_stream()
        while True:
            message = session.read(3600)
            if message is None:
                continue
            method = message.get("method")
            if isinstance(method, str) and method.startswith("Network.") and event_filter.matches(message):
                emit_event(message, options.json)


def route(method, path):
    """Match an exact URL path, ignoring its query. Unmatched requests pass through."""
    method = method.upper()
    path = "/" + path.lstrip("/")
    if not method.isascii() or not method.isalpha() or "?" in path or "#" in path:
        raise ValueError("route requires an HTTP method and a path without a query or fragment")

    def decorate(handler):
        if not inspect.iscoroutinefunction(handler):
            raise TypeError("@route handlers must use async def")
        handler.__snapo_routes__ = [*getattr(handler, "__snapo_routes__", []), (method, path)]
        return handler

    return decorate


class Headers(MutableMapping):
    """Case-insensitive headers that preserve repeated values such as Set-Cookie."""

    def __init__(self, entries=()):
        self._entries = [(entry["name"], entry["value"]) for entry in entries]

    def __getitem__(self, name):
        for key, value in reversed(self._entries):
            if key.lower() == name.lower():
                return value
        raise KeyError(name)

    def __setitem__(self, name, value):
        self._entries = [(key, val) for key, val in self._entries if key.lower() != name.lower()]
        self.add(name, value)

    def __delitem__(self, name):
        self[name]
        self._entries = [(key, val) for key, val in self._entries if key.lower() != name.lower()]

    def __iter__(self):
        return iter(dict((key.lower(), key) for key, _ in self._entries).values())

    def __len__(self):
        return len(set(key.lower() for key, _ in self._entries))

    def add(self, name, value):
        if not isinstance(name, str) or not isinstance(value, str) or not name or any(c in name + value for c in "\r\n"):
            raise ValueError("Headers require a name and string value without newlines")
        self._entries.append((name, value))

    def get_all(self, name):
        return [value for key, value in self._entries if key.lower() == name.lower()]

    def _wire(self):
        return [{"name": key, "value": value} for key, value in self._entries]


class Request:
    def __init__(self, wire, path):
        self.method = wire["method"]
        self.url = wire["url"]
        self.path = path
        self.headers = Headers(wire.get("headerEntries", []))
        self.body = base64.b64decode(wire.get("body", ""), validate=True)

    @property
    def json(self):
        return json.loads(self.body)


class Response:
    def __init__(self, status=200, body=b"", headers=None):
        self.status = status
        self.headers = headers if headers is not None else Headers()
        self._body = body
        self._json = _UNSET
        self._original_json = _UNSET

    @property
    def json(self):
        if self._json is _UNSET:
            self._json = json.loads(self._body)
            self._original_json = self._serialize_json()
        return self._json

    @json.setter
    def json(self, value):
        self._json = value
        self._original_json = _UNSET

    def _serialize_json(self):
        return json.dumps(self._json, ensure_ascii=False, allow_nan=False, separators=(",", ":")).encode("utf-8")

    @property
    def _json_modified(self):
        return self._json is not _UNSET and self._serialize_json() != self._original_json

    @property
    def body(self):
        if self._json_modified:
            return self._serialize_json()
        return self._body

    @body.setter
    def body(self, value):
        self._body = value
        self._json = _UNSET

    @classmethod
    def _from_wire(cls, wire):
        return cls(wire["status"], base64.b64decode(wire["body"], validate=True), Headers(wire["headerEntries"]))

    def _wire(self, method):
        if not isinstance(self.status, int) or not 200 <= self.status <= 599:
            raise ValueError("Response status must be between 200 and 599")
        body = self.body
        if not isinstance(body, bytes):
            raise TypeError("response.body must be bytes; use response.json for JSON")
        if len(body) > MAX_BODY_BYTES:
            raise ValueError("Response body exceeds 1 MiB")
        headers = Headers(self.headers._wire())
        for name in ("Transfer-Encoding", "Connection", "Keep-Alive", "Trailer"):
            headers.pop(name, None)
        if self._json_modified:
            headers.pop("Content-Encoding", None)
            headers["Content-Type"] = "application/json; charset=utf-8"
        if self.status in (204, 205, 304):
            body = b""
            headers.pop("Content-Length", None)
        elif method != "HEAD" and headers.get("Content-Length") != str(len(body)):
            headers["Content-Length"] = str(len(body))
        return {
            "status": self.status,
            "headerEntries": headers._wire(),
            "body": base64.b64encode(b"" if method == "HEAD" else body).decode("ascii"),
        }


_route_api = types.ModuleType("snapo_network")
for _name in ("route", "Request", "Response", "Headers"):
    setattr(_route_api, _name, globals()[_name])
sys.modules["snapo_network"] = _route_api
sys.modules["snapo"] = _route_api  # Keep existing Python override files working.


def load_routes(path):
    path = pathlib.Path(path).resolve()
    source = path.read_bytes()
    original_path = sys.path.copy()
    # Resolve helpers next to the user's file, as Python does for an ordinary script.
    sys.path.insert(0, str(path.parent))
    try:
        namespace = runpy.run_path(str(path), run_name=f"snapo_routes_{uuid.uuid4().hex}")
        if path.read_bytes() != source:
            raise ValueError("Route file changed while loading; save it again")
        routes = {}
        seen = set()
        for handler in namespace.values():
            if id(handler) in seen:
                continue
            seen.add(id(handler))
            for key in getattr(handler, "__snapo_routes__", []):
                if key in routes:
                    raise ValueError(f"Duplicate route: {key[0]} {key[1]}")
                routes[key] = handler
        if not routes:
            raise ValueError("No @route handlers found")
        if len(routes) > 128:
            raise ValueError("Register at most 128 routes")
        return routes, hashlib.sha256(source).digest()
    finally:
        sys.path[:] = original_path


class Call:
    def __init__(self, runner, event, path):
        self.request = Request(event["request"], path)
        self._runner = runner
        self._id = event["exchangeId"]
        self._upstream_task = None
        self._response = asyncio.get_running_loop().create_future()
        self._finalizing = False
        self._phase = "request"

    async def upstream(self):
        """Send the original request on Android once, and return its response."""
        if self._upstream_task is None:
            self._upstream_task = asyncio.create_task(self._fetch())
        return await asyncio.shield(self._upstream_task)

    async def _fetch(self):
        await self._runner.resolve(self._id, "upstream")
        return await self._response

    def json(self, value, status=200, headers=None):
        response = Response(status)
        response.json = value
        if headers:
            response.headers.update(headers)
        return response

    def _cancel(self):
        self._response.cancel()
        if self._upstream_task is not None:
            self._upstream_task.cancel()


class Runner:
    def __init__(self, open_socket, path, routes, digest, timeout=30, watch=True, log=print):
        self.open_socket = open_socket
        self.path = pathlib.Path(path)
        self.routes = routes
        self.digest = digest
        self.timeout = timeout
        self.watch = watch
        self.log = log
        self.runner_id = None
        self.events = None
        self._http_slots = asyncio.Semaphore(16)
        self._handlers = {}
        self._handler_expiry = {}
        self._calls = {}
        self._tasks = {}
        self._reader_task = None

    async def _open(self, response_type, path, method="GET", body=None):
        task = asyncio.create_task(asyncio.to_thread(
            response_type, self.open_socket, path, method, body))
        try:
            return await asyncio.shield(task)
        except asyncio.CancelledError:
            # Opening a socket in a worker cannot be cancelled. Close its eventual result.
            def close_result(completed):
                if not completed.cancelled() and completed.exception() is None:
                    completed.result().close()
            task.add_done_callback(close_result)
            raise

    async def request(self, path, method, body=None):
        async with self._http_slots:
            with closing(await self._open(HTTPResponse, path, method, body)) as response:
                return await asyncio.to_thread(response.read_json)

    async def resolve(self, identifier, action, **values):
        call = self._calls[identifier]
        path = f"/interception/{quote(self.runner_id, safe='')}/exchanges/{quote(identifier, safe='')}"
        await self.request(path, "POST", {"phase": call._phase, "action": action, **values})

    async def install(self, routes):
        generation = uuid.uuid4().hex
        wire = []
        for index, ((method, path), handler) in enumerate(routes.items()):
            identifier = f"{generation}:{index}"
            self._handlers[identifier] = (handler, path)
            wire.append({"id": identifier, "method": method, "path": path})
        configuration = {"routes": wire, "timeoutMs": int(self.timeout * 1000)}
        if self.runner_id is None:
            self.events = await self._open(NetworkSSE, "/interception", "POST", configuration)
            location = self.events.response.getheader("Location", "")
            match = re.fullmatch(r"/interception/([A-Za-z0-9-]+)", location)
            if self.events.response.status != 201 or match is None:
                raise SnapOError("Interception stream did not return its location")
            self.runner_id = match.group(1)
        else:
            await self.request(f"/interception/{quote(self.runner_id, safe='')}/routes", "PUT", configuration)
        # Android may have matched an old route but still be reading its request body.
        # Keep retired generations for the lifetime of those paused exchanges.
        now = asyncio.get_running_loop().time()
        active = {item["id"] for item in wire}
        for identifier in list(self._handlers):
            if identifier not in active:
                expiry = self._handler_expiry.setdefault(identifier, now + self.timeout + 1)
                if expiry < now:
                    self._handlers.pop(identifier, None)
                    self._handler_expiry.pop(identifier, None)
        self.routes = routes
        self.log(f"Loaded {len(routes)} route(s) from {self.path}")

    async def run(self):
        watcher = None
        try:
            await self.install(self.routes)
            self._reader_task = asyncio.create_task(self._read())
            if self.watch:
                watcher = asyncio.create_task(self._watch())
            running = [self._reader_task, *([watcher] if watcher else [])]
            done, _ = await asyncio.wait(running, return_when=asyncio.FIRST_COMPLETED)
            for task in done:
                task.result()
        finally:
            # Closing the owning SSE connection unregisters routes and releases its reader.
            if self.events is not None:
                self.events.close()
            tasks = [*self._tasks.values(), *([self._reader_task] if self._reader_task else []),
                     *([watcher] if watcher else [])]
            for task in tasks:
                task.cancel()
            for call in list(self._calls.values()):
                call._cancel()
            await asyncio.gather(*tasks, return_exceptions=True)

    async def _read(self):
        while True:
            message = (await asyncio.to_thread(self.events.read_event))["data"]
            if not isinstance(message, dict) or not isinstance(message.get("params"), dict):
                raise SnapOError("Invalid interception event")
            event = message["params"]
            identifier = event.get("exchangeId")
            if not isinstance(identifier, str) or not identifier:
                raise SnapOError("Invalid interception exchange ID")
            method = message.get("method")
            if method == "SnapO.intercept.request":
                if identifier in self._tasks or len(self._tasks) >= 64:
                    raise SnapOError("Interception exchange limit exceeded")
                handler, path = self._handlers.get(event["routeId"], (None, None))
                call = Call(self, event, path)
                self._calls[identifier] = call
                self._tasks[identifier] = asyncio.create_task(self._handle(call, handler))
            elif method == "SnapO.intercept.response":
                call = self._calls.get(identifier)
                if call is not None and not call._response.done():
                    call._phase = "response"
                    call._response.set_result(Response._from_wire(event["response"]))
            elif method == "SnapO.intercept.finished":
                call = self._calls.get(identifier)
                if identifier in self._tasks and (call is None or not call._finalizing):
                    if call is not None:
                        self.log(f"Request ended before handler completed: {call.request.method} {call.request.path}")
                    self._tasks[identifier].cancel()
                    if call is not None:
                        call._cancel()
                    self._calls.pop(identifier, None)
                    self._tasks.pop(identifier, None)
            else:
                raise SnapOError("Unknown interception event")

    async def _handle(self, call, handler):
        identifier = call._id
        try:
            if handler is None:
                raise RuntimeError("Handler is no longer loaded")
            response = await asyncio.wait_for(handler(call), self.timeout)
            if not isinstance(response, Response):
                raise TypeError("Return call.json(...) or the response from await call.upstream()")
            wire = response._wire(call.request.method)
            call._finalizing = True
            await self.resolve(identifier, "fulfill", response=wire)
            self.log(f"{call.request.method} {call.request.path} -> {response.status}")
        except Exception as error:
            self.log(f"Handler failed for {call.request.method} {call.request.path}: {type(error).__name__}: {error}")
            call._finalizing = True
            try:
                await self.resolve(identifier, "fail", error=f"Python handler failed: {type(error).__name__}")
            except (SnapOError, ConnectionError, RuntimeError, asyncio.TimeoutError):
                pass
        finally:
            call._cancel()
            self._calls.pop(identifier, None)
            self._tasks.pop(identifier, None)

    async def _watch(self):
        last_attempt = self.digest
        while True:
            await asyncio.sleep(0.5)
            try:
                digest = hashlib.sha256(self.path.read_bytes()).digest()
                if digest == last_attempt:
                    continue
                last_attempt = digest
                routes, digest = load_routes(self.path)
            except Exception as error:
                self.log(f"Reload failed; keeping existing routes: {error}")
                continue
            # If registration fails, close the connection. A timed-out acknowledgment
            # cannot tell us whether Android installed the new routes.
            await self.install(routes)
            self.digest = digest


def run_intercept(adb, options):
    path = pathlib.Path(options.file).resolve()
    try:
        routes, digest = load_routes(path)
        if not 0.1 <= options.timeout <= 120:
            raise ValueError("--timeout must be between 0.1 and 120 seconds")
        if options.check:
            for method, route_path in routes:
                print(f"{method} {route_path}")
            return 0
        server = choose_server(discover(adb, options), options.socket)
        with ServerConnection(adb, server) as connection:
            check_protocol(connection.open_socket)
            runner = Runner(connection.open_socket, path, routes, digest, options.timeout,
                            not options.no_watch, log=lambda line: print(line, file=sys.stderr, flush=True))
            asyncio.run(runner.run())
    except Exception as error:
        raise SnapOError(str(error)) from error
    return 0


@dataclass
class RequestState:
    request_id: str
    request_seen: bool = False
    response_seen: bool = False
    terminal: bool = False
    has_post_data: bool = False
    request_method: str = None
    request_url: str = None
    request_headers: dict = field(default_factory=dict)
    request_body_encoding: str = None
    response_status: int = None
    response_url: str = None
    response_headers: dict = field(default_factory=dict)
    failure: str = None

    def update(self, message):
        params = message.get("params") or {}
        if str(params.get("requestId", "")) != self.request_id:
            return
        method = message.get("method")
        if method == "Network.requestWillBeSent":
            request = params.get("request") or {}
            self.request_seen = True
            self.has_post_data = bool(request.get("hasPostData"))
            self.request_method = request.get("method")
            self.request_url = request.get("url")
            self.request_headers = redact_headers(request.get("headers"), REQUEST_HEADERS)
            self.request_body_encoding = request.get("postDataEncoding")
        elif method == "Network.responseReceived":
            response = params.get("response") or {}
            self.response_seen = True
            status = response.get("status")
            self.response_status = int(status) if isinstance(status, (int, float)) else None
            self.response_url = response.get("url")
            self.response_headers = redact_headers(response.get("headers"), RESPONSE_HEADERS)
        elif method == "Network.loadingFinished":
            self.terminal = True
            self.failure = None
        elif method == "Network.loadingFailed":
            self.terminal = True
            self.failure = params.get("errorText") or params.get("type")

    def has_no_response_body(self):
        if (self.request_method or "").upper() == "HEAD":
            return True
        if self.response_status is not None and (
            100 <= self.response_status <= 199 or self.response_status in {204, 205, 304}
        ):
            return True
        for name, value in self.response_headers.items():
            if name.lower() == "content-length":
                length = value.strip()
                return length.isascii() and length.isdecimal() and not length.strip("0")
        return False


def body_result(session, request_id, response=False):
    last_error = None
    for _ in range(3):
        try:
            return session.body(request_id, response)
        except HTTPError as error:
            if error.status == 404:
                return None
            raise
        except SnapOError as error:
            last_error = error
    raise last_error


def request_details(session, server, request_id):
    state = RequestState(request_id)
    session.start_stream()
    deadline = time.monotonic() + 5
    extended = False
    replaying = True
    while time.monotonic() < deadline:
        message = session.read(min(0.5, max(0, deadline - time.monotonic())))
        if message:
            state.update(message)
            if not extended and replaying:
                deadline = time.monotonic() + 5
        replaying = session.replaying
        if state.request_seen and not extended:
            deadline = time.monotonic() + 70
            extended = True
        if state.terminal:
            break
    if not state.request_seen:
        raise SnapOError(f"Timed out waiting for network lifecycle for {request_id} on {server.identifier}")
    if not state.terminal:
        raise SnapOError(f"Timed out waiting for network lifecycle for {request_id} on {server.identifier}")
    if not state.response_seen:
        raise SnapOError(state.failure or f"Request failed before receiving a response for {request_id}")

    request_body = None
    if state.has_post_data:
        result = body_result(session, request_id)
        if result is not None:
            request_body = result.get("postData")
            if not isinstance(request_body, str):
                raise SnapOError("Malformed request body response")

    response_body = ""
    base64_encoded = False
    if not state.has_no_response_body():
        result = body_result(session, request_id, response=True)
        if result is None:
            if state.failure:
                raise SnapOError(state.failure)
        else:
            response_body = result.get("body")
            base64_encoded = result.get("base64Encoded")
            if not isinstance(response_body, str) or not isinstance(base64_encoded, bool):
                raise SnapOError("Malformed response body response")

    return {
        "server": server.identifier,
        "requestId": request_id,
        "requestMethod": state.request_method,
        "requestUrl": state.request_url,
        "requestHeaders": state.request_headers,
        "requestBodyEncoding": state.request_body_encoding,
        "requestBody": request_body,
        "responseStatus": state.response_status,
        "responseUrl": state.response_url,
        "responseHeaders": state.response_headers,
        "responseBody": response_body,
        "responseBodyBase64Encoded": base64_encoded,
    }


def decoded_body(body, encoding, content_encoding):
    if (encoding or "").lower() != "base64" or not content_encoding:
        return body
    values = content_encoding.replace(",", "\n").splitlines()
    encodings = [value.split(";", 1)[0].strip().lower() for value in values]
    if not any(value in {"gzip", "x-gzip"} for value in encodings):
        return body
    try:
        return gzip.decompress(base64.b64decode(body)).decode("utf-8")
    except (EOFError, OSError, ValueError, UnicodeDecodeError):
        return body


def header_value(headers, name):
    return next((value for key, value in headers.items() if key.lower() == name.lower()), None)


def emit_details(details, as_json):
    if as_json:
        print_json(details)
        return
    print(f"Server: {details['server']}")
    print(f"Request ID: {details['requestId']}")
    print(f"Request: {details['requestMethod'] or 'unknown'} {details['requestUrl'] or 'unknown'}")
    emit_headers("Request Headers", details["requestHeaders"])
    print(f"Response: {details['responseStatus'] or 'unknown'} {details['responseUrl'] or 'unknown'}")
    emit_headers("Response Headers", details["responseHeaders"])
    print("Request Body:")
    body = details["requestBody"]
    if body is None:
        print("<none>")
    else:
        print(
            decoded_body(
                body,
                details["requestBodyEncoding"],
                header_value(details["requestHeaders"], "Content-Encoding"),
            )
        )
    print(f"Response Body (base64 encoded: {str(details['responseBodyBase64Encoded']).lower()}):")
    print(details["responseBody"])


def emit_headers(title, headers):
    print(f"{title}:")
    if not headers:
        print("  <none>")
    for name, value in sorted(headers.items(), key=lambda item: item[0].lower()):
        print(f"  {name}: {value}")


def run_show(adb, options):
    server = choose_server(discover(adb, options), options.socket)
    with ConnectedSession(adb, server) as session:
        details = request_details(session, server, options.request_id)
    emit_details(details, options.json)
    return 0


class ArgumentParser(argparse.ArgumentParser):
    def parse_args(self, args=None, namespace=None):
        arguments = list(sys.argv[1:] if args is None else args)
        for index in range(len(arguments) - 2, -1, -1):
            if arguments[index] != "--filter":
                continue
            value = arguments[index + 1]
            if value.startswith("-") and not value.startswith("--") and value not in {"-d", "-e", "-s", "-n", "-r"}:
                arguments[index:index + 2] = [f"--filter={value}"]
        options = super().parse_args(arguments, namespace)
        if hasattr(options, "adb_host") and (options.adb_host is None) != (options.adb_port is None):
            self.error("--adb-host and --adb-port must be used together")
        if hasattr(options, "adb_timeout") and not 0 < options.adb_timeout <= 90:
            self.error("--adb-timeout must be greater than 0 and at most 90 seconds")
        return options


def parser():
    root = ArgumentParser(prog="snapo-network", description="Snap-O Network command line tool")
    commands = root.add_subparsers(dest="command")
    list_parser = commands.add_parser("list", help="list available Snap-O network servers")
    add_common_options(list_parser)
    list_parser.add_argument("--no-app-info", dest="include_app_info", action="store_false")
    list_parser.set_defaults(handler=run_list, include_app_info=True)

    requests = commands.add_parser("requests", help="emit CDP network events")
    add_common_options(requests, socket_option=True)
    requests.add_argument("--filter", default="", help="filter URLs using Network Tool search syntax")
    requests.add_argument("--no-stream", action="store_true", help="stop after buffered replay completes")
    requests.set_defaults(handler=run_requests)

    show = commands.add_parser("show", help="show details for a request ID")
    add_common_options(show, socket_option=True)
    show.add_argument("-r", "--request-id", required=True)
    show.set_defaults(handler=run_show)

    intercept = commands.add_parser("intercept", help="override API responses with Python @route handlers")
    add_common_options(intercept, socket_option=True, json_option=False)
    intercept.add_argument("file", help="Python file containing @route handlers")
    intercept.add_argument("--timeout", type=float, default=30, help="maximum paused request duration in seconds (default: 30)")
    intercept.add_argument("--no-watch", action="store_true", help="disable automatic file reload")
    intercept.add_argument("--check", action="store_true", help="load and list routes without connecting to a device")
    intercept.set_defaults(handler=run_intercept)

    return root


def main(arguments=None):
    cli = parser()
    options = cli.parse_args(arguments)
    if options.command is None:
        cli.print_help()
        return 0
    try:
        adb = None if getattr(options, "check", False) else ADB(resolve_adb(options.adb), host=options.adb_host, port=options.adb_port, timeout=options.adb_timeout)
        return options.handler(adb, options)
    except KeyboardInterrupt:
        return 130
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except BrokenPipeError:
            pass
        return 0
    except SnapOError as error:
        print(f"snapo-network: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    signal.signal(signal.SIGINT, interrupted)
    signal.signal(signal.SIGTERM, interrupted)
    sys.exit(main())
