    "jsdom": "^27.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.9",
    "vitest": "^4.1.9"
  },
  "workspaces": [
    "*"
  ]
