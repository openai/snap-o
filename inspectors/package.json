{
  "name": "snapo-inspectors",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
